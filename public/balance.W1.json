{
  "$schema": "ND-balance-v1",
  "version": "W1.4",
  "createdBy": "Robin",
  "createdAt": "2026-05-06T04:25:00Z",
  "updatedAt": "2026-05-09T04:20:00Z",
  "notes": "W1.4 — Common Core curriculum 매핑 정합 (성철 피드백, Robin 결정 2026-05-09). (1) variableCount ramp: 7-9 T4-T5 = 3, 10-12 T3 = 3 (G3 multi-step / G5 order of ops 매칭). 5-6은 2 고정 (working memory 4 chunks 제한). (2) 10-12 max ramp 매끄럽게: T1 12→25, T2 20→40, T3 30→60 (G4-G5 progression). T4-T5는 보합. mixed3op (var=4) 신규는 wave 2로 보류, bracket 쪼개기는 wave 3 데이터 후 결정.",

  "ageBuckets": ["5-6", "7-9", "10-12"],
  "tiers": [1, 2, 3, 4, 5],
  "roundToTier": {
    "rule": "ceil(round / 3)",
    "examples": {"R1-3": "T1", "R4-6": "T2", "R7-9": "T3", "R10-12": "T4", "R13+": "T5"}
  },

  "allowedOps": {
    "5-6": {
      "T1": ["add"],
      "T2": ["add"],
      "T3": ["add"],
      "T4": ["add", "sub"],
      "T5": ["add", "sub"]
    },
    "7-9": {
      "T1": ["add"],
      "T2": ["add"],
      "T3": ["add", "sub"],
      "T4": ["add", "sub", "mul"],
      "T5": ["add", "sub", "mul"]
    },
    "10-12": {
      "T1": ["add", "mul"],
      "T2": ["add", "sub", "mul"],
      "T3": ["add", "sub", "mul", "div"],
      "T4": ["add", "sub", "mul", "div", "mixed2op"],
      "T5": ["add", "sub", "mul", "div", "mixed2op"]
    }
  },

  "operandRange": {
    "5-6": {
      "T1": {"min": 1, "max": 5,  "digits": 1, "_note": "1+1, 2+3 — sums ≤ 10"},
      "T2": {"min": 1, "max": 7,  "digits": 1, "_note": "sums ≤ 14, 한참 10 밑"},
      "T3": {"min": 1, "max": 10, "digits": "1-2", "_note": "비로소 10 도달, 합 ≤ 20"},
      "T4": {"min": 1, "max": 10, "digits": "1-2", "_note": "max 동결 + sub 도입 (인지 부하 보상)"},
      "T5": {"min": 1, "max": 12, "digits": "1-2", "_note": "add+sub 안정, 약간만 ramp"}
    },
    "7-9": {
      "T1": {"min": 1, "max": 10, "digits": "1-2"},
      "T2": {"min": 1, "max": 12, "digits": "1-2", "_note": "+20%, add only 안정"},
      "T3": {"min": 1, "max": 15, "digits": "1-2", "noCarry": true, "_note": "+25% + sub 도입"},
      "T4": {"min": 1, "max": 20, "digits": "1-2", "carry": true, "mulRange": [2, 5], "_note": "+33% + mul 도입 (×2-5)"},
      "T5": {"min": 1, "max": 30, "digits": "1-2", "carry": true, "mulRange": [2, 9], "_note": "+50% + mul ×2-9"}
    },
    "10-12": {
      "T1": {"min": 1, "max": 25, "mulSingleDigit": true, "_note": "G4 baseline — multi-digit 3×1 표준 매칭 (Robin 2026-05-09)"},
      "T2": {"min": 1, "max": 40, "_note": "+60% + sub 도입, G4-G5 transition"},
      "T3": {"min": 1, "max": 60, "_note": "+50% + div 도입, G5 order of ops 등장"},
      "T4": {"min": 1, "max": 50, "_note": "mixed2op 도입 (var=3) — max는 보합, 구조 복잡도 ↑"},
      "T5": {"min": 1, "max": 99, "multiStepDepth": 3, "_note": "+98% + multi-step depth 3"}
    }
  },

  "tierConfig": {
    "_comment": "Per-bracket per-tier. v3 — unlock 임계 대폭 늘림 (한 tier 15-30 kills 머무름), pool cap 3-8 더 작게.",
    "5-6": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 1, "fallDurationMs": 25000, "variableCount": 2, "poolCap": 3},
      "T2": {"unlockAt": 15, "spawnPerWave": 1, "fallDurationMs": 22000, "variableCount": 2, "poolCap": 3},
      "T3": {"unlockAt": 35, "spawnPerWave": 1, "fallDurationMs": 22000, "variableCount": 2, "poolCap": 4},
      "T4": {"unlockAt": 60, "spawnPerWave": 2, "fallDurationMs": 20000, "variableCount": 2, "poolCap": 4},
      "T5": {"unlockAt": 90, "spawnPerWave": 2, "fallDurationMs": 18000, "variableCount": 2, "poolCap": 5}
    },
    "7-9": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 2, "fallDurationMs": 20000, "variableCount": 2, "poolCap": 4},
      "T2": {"unlockAt": 15, "spawnPerWave": 2, "fallDurationMs": 18000, "variableCount": 2, "poolCap": 4},
      "T3": {"unlockAt": 35, "spawnPerWave": 2, "fallDurationMs": 16000, "variableCount": 2, "poolCap": 5},
      "T4": {"unlockAt": 60, "spawnPerWave": 3, "fallDurationMs": 14000, "variableCount": 3, "poolCap": 6},
      "T5": {"unlockAt": 90, "spawnPerWave": 3, "fallDurationMs": 13000, "variableCount": 3, "poolCap": 7}
    },
    "10-12": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 3, "fallDurationMs": 16000, "variableCount": 2, "poolCap": 5},
      "T2": {"unlockAt": 15, "spawnPerWave": 3, "fallDurationMs": 15000, "variableCount": 2, "poolCap": 5},
      "T3": {"unlockAt": 35, "spawnPerWave": 3, "fallDurationMs": 14000, "variableCount": 3, "poolCap": 6},
      "T4": {"unlockAt": 60, "spawnPerWave": 3, "fallDurationMs": 13000, "variableCount": 3, "poolCap": 7},
      "T5": {"unlockAt": 90, "spawnPerWave": 3, "fallDurationMs": 12000, "variableCount": 3, "poolCap": 8}
    }
  },

  "pool": {
    "cap": 12,
    "minOnScreen": 4,
    "answerGuarantee": {
      "rerollMaxN": 3,
      "rerollStrategy": "regenerateAnswerCandidates",
      "fallback": {
        "type": "partialReshuffle",
        "replaceCount": 8,
        "preserveCount": 4,
        "preserveStrategy": "FIFO_oldest_kept_replaced"
      }
    },
    "returnJitter": {
      "enabled": true,
      "range": [-1, 1],
      "clampMin": 1,
      "clampMax": 9,
      "applyToOpKinds": ["balloonReturn", "tankReturn"]
    },
    "entropyGuard": {
      "threshold": 2.5,
      "window": 5,
      "metric": "shannon_log2_over_1to9",
      "action": "forcedReshuffle",
      "telemetryDriven": false,
      "_calibrationNote": "W1=hardcoded; W2 베타 후 fallback trigger 빈도 0.05-0.15/wave 유지하도록 자동 조정"
    }
  },

