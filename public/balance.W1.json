    "_distributionRule": "5-6 = balloon-only; 7-9/10-12 도입 라운드 30-50% 비중, 다음 라운드부터 점진 normalize, R12+ 고정"
  },

  "constraints": {
    "5-6": {
      "splitterShieldedCoOccurrenceCapPercent": 0,
      "_note": "Kindergarten — variant enemies disabled entirely (see enemyDistribution.byBracket.5-6)"
    },
    "7-9": {
      "splitterShieldedCoOccurrenceCapPercent": 30,
      "_note": "한 wave 안에 Splitter + Shielded 동시 등장 wave 비율 ≤ 30% (frustration 게이트)"
    },
    "10-12": {
      "splitterShieldedCoOccurrenceCapPercent": null
    },
    "global": {
      "maxOperandsPerProblem": 3,
      "maxAnswerValue": 999,
      "negativeAnswerAllowed": false
    }
  },

  "towers": {
    "low":  {"damage": 1, "cost": 5},
    "mid":  {"damage": 2, "cost": 12},
    "high": {"damage": 3, "cost": 25}
  },

  "spawn": {
    "wavePeriodSec": 60,
    "_note": "Per-tier spawnPerWave is now in tierConfig.<bracket>.<tier>.spawnPerWave (per-bracket override). Legacy fallback below.",
    "spawnPerWave": {"T1": 3, "T2": 2, "T3": 2, "T4": 2, "T5": 2}
  },

  "telemetry": {
    "events": [
      "problem_attempt",
      "pool_reroll",
      "pool_fallback_triggered",
      "pool_entropy_sample",
      "wave_start",
      "wave_end",
      "mid_wave_abandon"
    ],
    "endpoints": {
      "distribution": "GET /admin/td/distribution?age=<bucket>&tier=<n>",
      "poolEntropy": "GET /admin/td/pool-entropy?session_id=<uuid>"
    }
  },

