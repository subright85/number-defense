{
  "$schema": "ND-balance-v1",
  "version": "W1.1",
  "createdBy": "Robin",
  "createdAt": "2026-05-06T04:25:00Z",
  "updatedAt": "2026-05-06T20:50:00Z",
  "notes": "ND mixed ops W1.1 — Kindergarten (5-6) bracket added, 7-9 ramp smoothed. Hot-reload 가능. W2 베타 후 telemetry-driven calibration.",

  "ageBuckets": ["5-6", "7-9", "10-12"],
  "tiers": [1, 2, 3, 4, 5],
  "roundToTier": {
    "rule": "ceil(round / 3)",
    "examples": {"R1-3": "T1", "R4-6": "T2", "R7-9": "T3", "R10-12": "T4", "R13+": "T5"}
  },

  "allowedOps": {
    "5-6": {
      "T1": ["add"],
      "T2": ["add"],
      "T3": ["add"],
      "T4": ["add", "sub"],
      "T5": ["add", "sub"]
    },
    "7-9": {
      "T1": ["add"],
      "T2": ["add", "sub"],
      "T3": ["add", "sub", "mul"],
      "T4": ["add", "sub", "mul"],
      "T5": ["add", "sub", "mul", "mixed2op"]
    },
    "10-12": {
      "T1": ["add", "mul"],
      "T2": ["add", "sub", "mul"],
      "T3": ["add", "sub", "mul", "div", "fractionSameDenom"],
      "T4": ["add", "sub", "mul", "div", "fractionDiffDenom", "decimal", "mixed2op"],
      "T5": ["add", "sub", "mul", "div", "fractionDiffDenom", "decimal", "mixedMulti", "ratio", "simplify"]
    }
  },

  "operandRange": {
    "5-6": {
      "T1": {"min": 1, "max": 3, "digits": 1, "_note": "1+1, 1+2, 2+3 — sums ≤ 5"},
      "T2": {"min": 1, "max": 5, "digits": 1, "_note": "sums ≤ 7"},
      "T3": {"min": 1, "max": 9, "digits": 1, "_note": "sums ≤ 10"},
      "T4": {"min": 1, "max": 9, "digits": 1, "_note": "add+sub within 10"},
      "T5": {"min": 1, "max": 10, "digits": "1-2", "noCarry": true, "_note": "within 20 no carry"}
    },
    "7-9": {
      "T1": {"min": 1, "max": 9, "digits": 1},
      "T2": {"min": 1, "max": 19, "digits": "1-2", "noCarry": true},
      "T3": {"min": 1, "max": 99, "digits": "1-2", "carry": true, "mulRange": [2, 5]},
      "T4": {"min": 1, "max": 99, "carry": true, "mulRange": [6, 9]},
      "T5": {"min": 1, "max": 99, "mixedTemplate": "a±b×c, ranges 1-9"}
    },
    "10-12": {
      "T1": {"min": 1, "max": 99, "mulSingleDigit": true},
      "T2": {"min": 1, "max": 999, "mulShape": "1d×2d"},
      "T3": {"min": 1, "max": 99, "fractionDenom": [2, 3, 4, 5, 6, 8, 10]},
      "T4": {"min": 1, "max": 99, "decimalRange": [0.1, 9.9]},
      "T5": {"min": 1, "max": 999, "multiStepDepth": 3}
    }
  },

  "tierConfig": {
    "_comment": "Per-bracket per-tier: unlockAt (kills to unlock), spawnPerWave, fallDurationMs, variableCount, poolCap. Replaces hardcoded TIER_UNLOCK_AT in loader.",
    "5-6": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 1, "fallDurationMs": 25000, "variableCount": 2, "poolCap": 6},
      "T2": {"unlockAt": 6,  "spawnPerWave": 1, "fallDurationMs": 22000, "variableCount": 2, "poolCap": 6},
      "T3": {"unlockAt": 15, "spawnPerWave": 2, "fallDurationMs": 20000, "variableCount": 2, "poolCap": 8},
      "T4": {"unlockAt": 27, "spawnPerWave": 2, "fallDurationMs": 18000, "variableCount": 2, "poolCap": 8},
      "T5": {"unlockAt": 42, "spawnPerWave": 2, "fallDurationMs": 16000, "variableCount": 2, "poolCap": 10}
    },
    "7-9": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 2, "fallDurationMs": 18000, "variableCount": 2, "poolCap": 10},
      "T2": {"unlockAt": 15, "spawnPerWave": 2, "fallDurationMs": 16000, "variableCount": 2, "poolCap": 12},
      "T3": {"unlockAt": 30, "spawnPerWave": 3, "fallDurationMs": 14000, "variableCount": 2, "poolCap": 12},
      "T4": {"unlockAt": 45, "spawnPerWave": 3, "fallDurationMs": 13000, "variableCount": 3, "poolCap": 12},
      "T5": {"unlockAt": 60, "spawnPerWave": 3, "fallDurationMs": 12000, "variableCount": 3, "poolCap": 12}
    },
    "10-12": {
      "T1": {"unlockAt": 0,  "spawnPerWave": 3, "fallDurationMs": 15000, "variableCount": 2, "poolCap": 12},
      "T2": {"unlockAt": 9,  "spawnPerWave": 3, "fallDurationMs": 14000, "variableCount": 2, "poolCap": 12},
      "T3": {"unlockAt": 18, "spawnPerWave": 3, "fallDurationMs": 13000, "variableCount": 2, "poolCap": 12},
      "T4": {"unlockAt": 27, "spawnPerWave": 3, "fallDurationMs": 12000, "variableCount": 3, "poolCap": 12},
      "T5": {"unlockAt": 36, "spawnPerWave": 3, "fallDurationMs": 11000, "variableCount": 3, "poolCap": 12}
    }
  },

  "pool": {
    "cap": 12,
    "minOnScreen": 4,
    "answerGuarantee": {
      "rerollMaxN": 3,
      "rerollStrategy": "regenerateAnswerCandidates",
      "fallback": {
        "type": "partialReshuffle",
        "replaceCount": 8,
        "preserveCount": 4,
        "preserveStrategy": "FIFO_oldest_kept_replaced"
      }
    },
    "returnJitter": {
      "enabled": true,
      "range": [-1, 1],
      "clampMin": 1,
      "clampMax": 9,
      "applyToOpKinds": ["balloonReturn", "tankReturn"]
    },
    "entropyGuard": {
      "threshold": 2.5,
      "window": 5,
      "metric": "shannon_log2_over_1to9",
      "action": "forcedReshuffle",
      "telemetryDriven": false,
      "_calibrationNote": "W1=hardcoded; W2 베타 후 fallback trigger 빈도 0.05-0.15/wave 유지하도록 자동 조정"
    }
  },

  "enemyDistribution": {
    "byBracket": {
      "5-6": {
        "_note": "Kindergarten — balloon-only across all rounds. Fast/splitter/shielded too overwhelming.",
        "byRound": {
          "1": {"balloon": 1.00}
        },
        "stableFromRound": 1,
        "stableDistribution": {"balloon": 1.00}
      },
      "7-9": {
        "byRound": {
          "1":  {"balloon": 1.00},
          "2":  {"balloon": 1.00},
