{
  "_comment": "Game-external learning layer. game/engine.ts does NOT read this. Problem generator + post-game analytics + admin distribution endpoint read this. Robin owns from W1 (2026-05-05).",
  "version": "1.0.0",
  "owner": "Robin",
  "created_at": "2026-05-05",
  "turn_to_seconds": 1.5,
  "tower_damage_multipliers": {
    "tier_1": 1,
    "tier_2": 1.5,
    "tier_3": 2,
    "tier_4": 2.5,
    "tier_5": 3,
    "_note": "Logical multipliers anchored to base matrix Low/Mid/High = ×1/×2/×3. T1/T3/T5 are matrix anchors; T2/T4 are linear interpolations per Franky 2026-05-05 spec. Real damage values live in balance.json (frozen interface)."
  },
  "age_buckets": {
    "7-9": {
      "label": "Grade 1-3",
      "tiers": {
        "1": {
          "problem_type": "1자리 덧셈",
          "examples": ["4 + 3", "2 + 5"],
          "target_correct_rate": 0.90,
          "target_solve_time_sec": 3,
          "pre_label": "warmup",
          "expected_dpm": { "tier_1_tower": 18.0, "tier_3_tower": 36.0, "tier_5_tower": 54.0 },
          "derived_safe_hp_mid_tower": 19,
          "derived_safe_spawn": 3
        },
        "2": {
          "problem_type": "1자리 뺄셈 + 2자리 덧셈 (no carry)",
          "examples": ["9 − 4", "12 + 5"],
          "target_correct_rate": 0.80,
          "target_solve_time_sec": 4,
          "pre_label": "core",
          "expected_dpm": { "tier_1_tower": 12.0, "tier_3_tower": 24.0, "tier_5_tower": 36.0 },
          "derived_safe_hp_mid_tower": 13,
          "derived_safe_spawn": 2
        },
        "3": {
          "problem_type": "받아내림 뺄셈 / 2자리 덧셈 (carry)",
          "examples": ["15 − 7", "38 + 24"],
          "target_correct_rate": 0.75,
          "target_solve_time_sec": 6,
          "pre_label": "challenge",
          "expected_dpm": { "tier_1_tower": 7.5, "tier_3_tower": 15.0, "tier_5_tower": 22.5 },
          "derived_safe_hp_mid_tower": 8,
          "derived_safe_spawn": 2
        },
        "4": {
          "problem_type": "곱셈 ×2-×5",
          "examples": ["4 × 6", "3 × 7"],
          "target_correct_rate": 0.70,
          "target_solve_time_sec": 7,
          "pre_label": "stretch",
          "expected_dpm": { "tier_1_tower": 6.0, "tier_3_tower": 12.0, "tier_5_tower": 18.0 },
          "derived_safe_hp_mid_tower": 6,
          "derived_safe_spawn": 2
        },
        "5": {
          "problem_type": "받아내림 큰수 / 곱셈 ×6-×9",
          "examples": ["200 − 87", "7 × 8"],
          "target_correct_rate": 0.65,
          "target_solve_time_sec": 9,
          "pre_label": "hard",
          "expected_dpm": { "tier_1_tower": 4.33, "tier_3_tower": 8.67, "tier_5_tower": 13.0 },
          "derived_safe_hp_mid_tower": 4,
          "derived_safe_spawn": 2
        }
      }
    },
    "10-12": {
      "label": "Grade 4-6",
      "tiers": {
        "1": {
          "problem_type": "곱셈 단 + 2자리 덧셈",
          "examples": ["8 × 9", "47 + 36"],
          "target_correct_rate": 0.92,
          "target_solve_time_sec": 3,
          "pre_label": "warmup",
          "expected_dpm": { "tier_1_tower": 18.4, "tier_3_tower": 36.8, "tier_5_tower": 55.2 },
          "derived_safe_hp_mid_tower": 20,
          "derived_safe_spawn": 3
        },
        "2": {
          "problem_type": "큰수 덧·뺄셈 / 곱셈 1자리×2자리",
          "examples": ["245 + 167", "7 × 23"],
          "target_correct_rate": 0.82,
          "target_solve_time_sec": 5,
          "pre_label": "core",
          "expected_dpm": { "tier_1_tower": 9.84, "tier_3_tower": 19.68, "tier_5_tower": 29.52 },
          "derived_safe_hp_mid_tower": 10,
          "derived_safe_spawn": 2
        },
        "3": {
          "problem_type": "나눗셈 + 분수 add/sub 분모 같음",
          "examples": ["47 ÷ 6", "1/4 + 2/4"],
          "target_correct_rate": 0.75,
          "target_solve_time_sec": 7,
          "pre_label": "challenge",
          "expected_dpm": { "tier_1_tower": 6.43, "tier_3_tower": 12.86, "tier_5_tower": 19.29 },
          "derived_safe_hp_mid_tower": 7,
          "derived_safe_spawn": 2
        },
        "4": {
          "problem_type": "분수 add/sub 분모 다름 / 소수 곱셈",
          "examples": ["1/3 + 1/4", "2.5 × 4"],
          "target_correct_rate": 0.70,
          "target_solve_time_sec": 9,
          "pre_label": "stretch",
          "expected_dpm": { "tier_1_tower": 4.67, "tier_3_tower": 9.33, "tier_5_tower": 14.0 },
          "derived_safe_hp_mid_tower": 5,
          "derived_safe_spawn": 2
        },
        "5": {
          "problem_type": "다단계 식 / 약분 / 비율",
          "examples": ["(12 + 8) ÷ 5", "3/12 simplify"],
          "target_correct_rate": 0.62,
          "target_solve_time_sec": 12,
          "pre_label": "hard",
          "expected_dpm": { "tier_1_tower": 3.10, "tier_3_tower": 6.20, "tier_5_tower": 9.30 },
          "derived_safe_hp_mid_tower": 3,
          "derived_safe_spawn": 2
        }
      }
    }
  },
  "dpm_formula": {
    "expression": "DPM = 60 / target_solve_time_sec × target_correct_rate × tower_damage_multiplier",
    "safe_hp_formula": "safe_hp = floor(DPM × 0.55)",
    "_note": "DPM is single-tower assumption. Real game has multi-tower portfolio; balance.json hpBase reflects multi-tower combined difficulty (Franky's design intent). expected_dpm here is for analytics — comparing measured player DPM against this baseline reveals frustration / easy windows."
  },
  "validation_spec": {
    "_purpose": "Spec encoded in data structure, not prose comment. W2 auto-feedback loop will read this and dispatch checks. Encoding methodology in data > encoding in text — text gets ignored, data structures get evaluated.",
    "checks": [
      {
        "id": "hartigan_dip_test_correct_rate",
        "trigger": {
          "min_n_attempts": 200,
          "groupby": ["age_bucket", "tier"],
          "metric": "correct_rate"
        },
        "test": "hartigan_dip_test",
        "alpha": 0.05,
        "alert_when": "p_value < alpha",
        "interpretation": "bimodal correct_rate distribution within (age, tier) → tier definition itself splits into two distinct groups",
        "action": "tier_redefine_candidate — emit to /admin/td/distribution + weekly review queue"
      },
      {
        "id": "correct_rate_drift",
        "trigger": {
          "min_n_attempts": 200,
          "groupby": ["age_bucket", "tier"],
          "metric": "correct_rate"
        },
        "test": "compare_to_target",
        "tolerance_pp": 10,
        "alert_when": "abs(measured - target) > tolerance_pp",
        "action": "tier_reclassify_candidate — next release tier remap"
      },
      {
        "id": "frustration_signal",
        "trigger": {
          "metric": "mid_wave_abandon_rate"
        },
        "alert_when": "rate > 0.30",
        "action": "reduce_spawn_or_hp_for_affected_wave"
      }
    ]
  },
  "post_game_event_schema": {
    "event_name": "problem_attempt",
    "fields": {
      "session_id": "uuid",
      "user_age_bucket": "7-9 | 10-12",
      "tier": "1..5",
      "problem_id": "string (e.g., tier3_carry_001)",
      "shown_at": "ISO8601",
      "answered_at": "ISO8601",
      "is_correct": "boolean",
      "wave_id": "integer"
    },
    "_collection_endpoint_w2": "/api/td/event"
  },
  "admin_distribution_endpoint": {
    "path": "/admin/td/distribution",
    "method": "GET",
    "params": ["age", "tier"],
    "returns": "histogram of correct_rate + n + bimodal flag",
    "_w2_implementation": "Sungcheol/Chopper QA hookup — wire after engine integration"
  },
  "tuning_cadence_weeks": 1
}
